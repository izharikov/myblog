---
import { Image } from 'astro:assets';
import { resolveImage } from '@/lib/images';

interface Props {
  posts: Array<{
    title: string;
    description: string;
    slug: string;
    logo: string;
    dateDisplay: string;
    tags: string[];
  }>;
  title?: string;
  showLink?: boolean;
  featured?: boolean;
}
const { posts, title = "Latest Posts", showLink = true, featured = false } = Astro.props;

const lead = featured ? posts[0] : undefined;
const rest = featured ? posts.slice(1) : posts;
const leadLogo = lead ? resolveImage(lead.logo) : undefined;

// Group posts by year
const grouped = rest.reduce<Record<string, typeof posts>>((acc, post) => {
  const year = post.dateDisplay.split(', ').pop()!;
  (acc[year] ??= []).push(post);
  return acc;
}, {});
const years = Object.keys(grouped).sort((a, b) => +b - +a);
---
<section class="my-8" id="blogs">
  <div>
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl mb-8">
      {title}
    </h2>

    {lead && (
      <a href={`/blogs/${lead.slug}`} class="group grid gap-5 sm:grid-cols-2 sm:items-center mb-12 p-3 -mx-3 rounded-xl hover:bg-surface-alt transition-colors">
        {leadLogo ? (
          <Image src={leadLogo()} alt="" class="w-full h-auto rounded-lg border" width={800} quality={90} />
        ) : (
          <div class="w-full aspect-video rounded-lg bg-surface-alt border" />
        )}
        <div class="min-w-0">
          <span class="text-xs font-semibold uppercase tracking-wider text-accent">Latest</span>
          <h3 class="mt-2 text-2xl font-semibold tracking-tight leading-snug group-hover:text-accent transition-colors">{lead.title}</h3>
          <p class="mt-2 text-text-secondary leading-relaxed line-clamp-4">{lead.description}</p>
          <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1.5 text-xs text-text-secondary">
            <time>{lead.dateDisplay}</time>
            {lead.tags.slice(0, 3).map(t => <span class="bg-surface-alt border border-border px-1.5 py-0.5 rounded">{t}</span>)}
          </div>
        </div>
      </a>
    )}

    <div>
      {years.map(year => (
        <div class="mb-10">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-text-secondary pb-2 border-b border-border">{year}</h3>
          {grouped[year].map(post => {
            const logoFn = resolveImage(post.logo);
            return (
              <a href={`/blogs/${post.slug}`} class="flex items-center gap-5 py-4 px-3 -mx-3 border-b border-border hover:bg-surface-alt transition-colors group">
                {logoFn ? (
                  <Image src={logoFn()} alt="" class="hidden sm:block w-36 h-20 rounded-lg border object-cover shrink-0" width={400} quality={90} />
                ) : (
                  <div class="hidden sm:block w-36 h-20 rounded-lg bg-surface-alt border shrink-0" />
                )}
                <div class="min-w-0 flex-1">
                  <h4 class="text-lg font-semibold tracking-tight leading-snug group-hover:text-accent transition-colors">{post.title}</h4>
                  <p class="mt-1 text-[0.9375rem] leading-relaxed text-text-secondary line-clamp-3 sm:line-clamp-2">{post.description}</p>
                  <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1.5 text-xs text-text-secondary">
                    <time>{post.dateDisplay}</time>
                    {post.tags.slice(0, 3).map(t => <span class="bg-surface-alt border border-border px-1.5 py-0.5 rounded">{t}</span>)}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ))}
    </div>

    {showLink && (
      <div class="text-center">
        <a href="/blogs" class="inline-flex items-center justify-center rounded-md border border-border bg-surface px-6 py-3 text-sm font-medium hover:bg-surface-alt hover:text-accent transition-colors">
          See All Blog Posts &rarr;
        </a>
      </div>
    )}
  </div>
</section>
