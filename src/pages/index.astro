---
import { getCollection } from 'astro:content';
import { getSlug } from '@/lib/blog';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/home/HeroSection.astro';
import BlogGrid from '@/components/blog/BlogGrid.astro';
import CredlyBadges from '@/components/about/CredlyBadges.astro';
import PageFrame from '@/components/layout/PageFrame.astro';
import { parseDate, formatDate } from '@/lib/date';
import { siteConfig } from '@/config/site';
import { personJsonLd } from '@/lib/json-ld';

const posts = await getCollection('blog');
const sorted = posts
  .sort((a, b) => parseDate(b.data.date).getTime() - parseDate(a.data.date).getTime())
  .slice(0, 6)
  .map(post => ({
    title: post.data.title,
    description: post.data.description,
    slug: getSlug(post),
    logo: post.data.logo,
    dateDisplay: formatDate(parseDate(post.data.date)),
    tags: post.data.tags,
  }));

const jsonLd = personJsonLd({ includeCredentials: true });
---
<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <PageFrame>
    <HeroSection />
    <BlogGrid posts={sorted} title="Latest Posts" showLink={true} featured={true} />
    <CredlyBadges variant="row" class="lg:hidden mt-12 mb-10" />
    <div slot="aside" class="sticky top-24 my-10">
      <CredlyBadges variant="sidebar" />
    </div>
  </PageFrame>
</BaseLayout>
