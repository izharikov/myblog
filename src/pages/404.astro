---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getSlug } from '@/lib/blog';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageFrame from '@/components/layout/PageFrame.astro';
import { resolveImage } from '@/lib/images';
import { parseDate, formatDate } from '@/lib/date';
import { siteConfig } from '@/config/site';

const posts = await getCollection('blog');
const recent = posts
  .sort((a, b) => parseDate(b.data.date).getTime() - parseDate(a.data.date).getTime())
  .slice(0, 3)
  .map(post => ({
    title: post.data.title,
    slug: getSlug(post),
    date: formatDate(parseDate(post.data.date)),
    logoFn: resolveImage(post.data.logo),
  }));

const host = new URL(siteConfig.site).host;
---

<BaseLayout title="Page not found" description="Page not found">
  <PageFrame>
    <div class="my-10 md:my-14">
      <div class="max-w-xl overflow-hidden rounded-xl border border-black/40 bg-[#1b1b1f] font-mono text-[0.8125rem] leading-relaxed text-[#d4d4d8] shadow-xl shadow-black/10">
        <div class="relative flex items-center gap-2 border-b border-white/10 bg-[#2a2a30] px-4 py-2.5">
          <span class="size-3 rounded-full bg-[#ff5f57]"></span>
          <span class="size-3 rounded-full bg-[#febc2e]"></span>
          <span class="size-3 rounded-full bg-[#28c840]"></span>
          <span class="absolute inset-x-0 text-center text-xs text-[#a1a1aa]">izharikov@blog: ~</span>
        </div>
        <div class="overflow-x-auto px-4 py-4 sm:px-5">
          <p class="whitespace-nowrap"><span class="text-[#4ade80]">izharikov@blog</span><span class="text-[#a1a1aa]">:</span><span class="text-[#60a5fa]">~</span><span class="text-[#a1a1aa]">$</span> curl -I https://{host}<span data-path>/unknown</span></p>
          <p class="mt-1 whitespace-nowrap">HTTP/2 <span class="font-semibold text-[#f87171]">404 Not Found</span></p>
          <p class="whitespace-nowrap text-[#a1a1aa]">content-type: text/html; charset=utf-8</p>
          <p class="whitespace-nowrap text-[#a1a1aa]">x-hint: try /blogs</p>
          <p class="mt-3 whitespace-nowrap"><span class="text-[#4ade80]">izharikov@blog</span><span class="text-[#a1a1aa]">:</span><span class="text-[#60a5fa]">~</span><span class="text-[#a1a1aa]">$</span> <span class="terminal-cursor inline-block h-[1.1em] w-[0.6em] translate-y-[0.15em] bg-[#d4d4d8]"></span></p>
        </div>
      </div>

      <h1 class="mt-10 text-4xl font-bold tracking-tight sm:text-5xl">Page not found</h1>
      <p class="mt-3 max-w-xl text-text-secondary leading-relaxed">The link may be outdated, or the post was renamed.</p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/blogs" class="inline-flex items-center justify-center rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-surface hover:bg-accent-hover transition-colors">Browse all posts</a>
        <a href="/" class="inline-flex items-center justify-center rounded-md border border-border bg-surface px-5 py-2.5 text-sm font-medium hover:bg-surface-alt hover:text-accent transition-colors">Go home</a>
      </div>

      <h2 class="mt-14 text-sm font-semibold uppercase tracking-wider text-text-secondary pb-2 border-b border-border">Latest posts</h2>
      <ul>
        {recent.map(post => (
          <li>
            <a href={`/blogs/${post.slug}`} class="group flex items-center gap-4 py-3 px-3 -mx-3 border-b border-border hover:bg-surface-alt transition-colors">
              {post.logoFn && <Image src={post.logoFn()} alt="" width={200} class="hidden sm:block w-24 h-14 rounded-md border object-cover shrink-0" />}
              <div class="min-w-0">
                <h3 class="font-semibold tracking-tight leading-snug group-hover:text-accent transition-colors">{post.title}</h3>
                <time class="mt-0.5 block text-xs text-text-secondary">{post.date}</time>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </PageFrame>

  <style>
    .terminal-cursor { animation: blink 1.1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
  </style>

  <script is:inline>
    document.querySelectorAll('[data-path]').forEach(el => { el.textContent = window.location.pathname; });
  </script>
</BaseLayout>
